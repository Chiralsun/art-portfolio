[200~# Create .gitignore file
cat > .gitignore << 'EOF'
# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables
.env
.env.local
.env.production
backend/.env

# Uploaded files
uploads/
backend/uploads/

# Build files
dist/
build/
backend/dist/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Package lock files (optional - many devs commit these)
# package-lock.json
# yarn.lock
